{
  "name": "ati-ph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker": "tsx src/worker/main.ts",
    "db:seed": "prisma db seed",
    "authz:grant": "tsx scripts/grant-role.ts",
    "verify:fast": "npm run typecheck && npm test && npm run lint",
    "verify": "npm run verify:fast && npm run build",
    "email:smtp:test": "node --env-file=.env --import tsx scripts/email-smtp-test.ts",
    "notification:smtp:pilot": "node --env-file=.env --import tsx scripts/notification-smtp-pilot.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tsx": "^4.23.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
