# ATI PH — SHARED TEST profile
#
# Copy to `.env` on the test deployment. Every variable ATI PH reads is written out
# below, including the ones whose value equals the code default, so this file alone
# tells you what the process will do.
#
#   what this profile is for   the shared test environment
#   email delivery             CONTROLLED PILOT — real SMTP, one internal mailbox
#   worker                     ENABLED, but it delivers nothing
#   can it email a client      no: automatic delivery is off, and the pilot overrides
#                              the recipient to a single internal address
#
# Why the worker runs here and not locally: everything it does *except* SMTP execution
# is worth exercising continuously — planning, scheduling, lease recovery, retry
# promotion, operational alerts, retention. This profile runs all of that against real
# data and still cannot deliver, because the delivery gates are shut.
#
# The pilot is a command, not something the worker does:
#
#   npm run notification:smtp:pilot -- --job <uuid> --send
#
# It takes a job's frozen content, verifies its SHA-256, overrides TO to the one
# address below, clears CC, sends through the real transport, and mutates no job state.

NODE_ENV=test

# ── Where the app is served ───────────────────────────────────────────────────
#
# Mounted behind ATI One. Every URL is the address the browser uses; the port this
# process binds does not appear anywhere here. Inlined at build time.
NEXT_PUBLIC_APP_BASE_PATH=/apps/ph-notification/app
DEV_APP_ORIGIN=https://test.atibusinessgroup.com
PUBLIC_APP_URL=https://test.atibusinessgroup.com/apps/ph-notification/app
OIDC_CALLBACK_URL=https://test.atibusinessgroup.com/apps/ph-notification/app/api/auth/callback/keycloak
ATI_ONE_RETURN_URL=https://test.atibusinessgroup.com/

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ati_ph_user:replace-with-db-password@postgres:5432/ati_ph_db?schema=public

# ── Identity ──────────────────────────────────────────────────────────────────
#
# The client ID is `ph-notif` in every environment; the secret is per realm and is never
# committed. Keycloak → Clients → ph-notif → Credentials.
KEYCLOAK_ISSUER=https://test.atibusinessgroup.com/auth/realms/ati-one
KEYCLOAK_CLIENT_ID=ph-notif
KEYCLOAK_CLIENT_SECRET=replace-with-client-secret

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30

# ── ATI One proxy ─────────────────────────────────────────────────────────────
#
# True, and the secret is not optional: this deployment publishes a port, so this
# header is the only thing standing between that port and anyone who can reach it.
TRUST_ATI_ONE_PROXY=true
ATI_ONE_PROXY_SECRET=replace-with-at-least-32-random-characters

# ── Storage and import limits ─────────────────────────────────────────────────
ARTIFACT_STORAGE_DIR=/var/lib/ati-ph/artifacts
IMPORT_MAX_FILE_SIZE_BYTES=10485760

# ── Worker ────────────────────────────────────────────────────────────────────
NOTIFICATION_WORKER_ENABLED=true

WORKER_POLL_INTERVAL_MS=60000
NOTIFICATION_SCHEDULER_BATCH_SIZE=100
NOTIFICATION_DELIVERY_BATCH_SIZE=25
NOTIFICATION_DELIVERY_LEASE_SECONDS=120

# Trusted planning on: this is where auto-commit is proven before production relies on
# it. It creates and approves plans; it does not send.
NOTIFICATION_TRUSTED_AUTOMATION_ENABLED=true
NOTIFICATION_AUTOMATION_BATCH_SIZE=50
NOTIFICATION_AUTOMATION_HORIZON_DAYS=400
NOTIFICATION_SCHEDULER_LAG_THRESHOLD_SECONDS=300

# On here, so the retention path is exercised somewhere before production.
NOTIFICATION_RETENTION_ENABLED=true
NOTIFICATION_OPERATIONAL_ALERT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_BATCH_SIZE=100

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_DELIVERY_MODE=SMTP

EMAIL_SENDER_IDENTITY_CODE=PH_NOTIFICATION
EMAIL_FROM_ADDRESS=apps@atibusinessgroup.com
EMAIL_FROM_NAME=ATI Business Group
# EMAIL_REPLY_TO=
EMAIL_TRANSPORT_CODE=ATI_GOOGLE_DIRECT

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true
EMAIL_SMTP_USER=apps@atibusinessgroup.com
EMAIL_SMTP_PASSWORD=replace-with-approved-application-credential
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000

# The connectivity test belongs to `.env.local.example`. The schema refuses both.
EMAIL_SMTP_TEST_ENABLED=false
EMAIL_SMTP_TEST_RECIPIENT=your.name@atibusinessgroup.com

# The pilot: this profile's delivery path. Recipient domain must equal the sender
# domain, and the pilot refuses to run if it does not.
EMAIL_SMTP_PILOT_ENABLED=true
EMAIL_SMTP_PILOT_RECIPIENT=your.name@atibusinessgroup.com

# Automatic worker delivery stays shut here, and this is the line that makes this a
# test profile rather than a production one. A passing pilot is evidence for opening
# it in production; it is not the act of opening it.
EMAIL_SMTP_AUTOMATIC_DELIVERY_ENABLED=false
EMAIL_DELIVERY_KILL_SWITCH=true
# EMAIL_DELIVERY_KILL_SWITCH_PATH=
EMAIL_SMTP_PRODUCTION_RELEASE_APPROVED=false

# ── Seeded delivery-test routing ──────────────────────────────────────────────
#
# Gives the pilot a job whose recipient is deliverable. Every `Client_Master` contact
# is `@dummy.test`, and recipient classification is fail-closed on partial acceptance,
# so a job containing one of those can only ever prove that SMTP rejects correctly.
DELIVERY_TEST_RECIPIENT=your.name@atibusinessgroup.com

# ── Bootstrap administrator ───────────────────────────────────────────────────
#
# One address that becomes ADMINISTRATOR by signing in, and only while it holds no role
# at all. A fresh database has roles and permissions but nobody holding them, so the
# first person to arrive is refused every screen — including the screen that grants
# roles. This is the way in.
#
# Unset means nobody, which is the safe default: a missing value fails as "no one can
# get in", which is loud and recoverable.
#
# ⚠ CLEAR THIS once a human administrator exists. While it is set, that account cannot
#   be demoted: strip its last role and the next sign-in grants ADMINISTRATOR again,
#   because from the application's side that is indistinguishable from a first sign-in.
#   Every grant is written to the audit trail with the reason.
# BOOTSTRAP_ADMINISTRATOR_EMAIL=
