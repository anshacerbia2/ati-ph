generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRATOR
  OPERATOR
  APPROVER
  AUDITOR
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id          String        @id @db.VarChar(191)
  email       String        @unique @db.VarChar(320)
  displayName String?       @db.VarChar(255)
  role        UserRole      @default(AUDITOR)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessions    AuthSession[]
  auditEvents AuditEvent[]

  @@index([role, isActive])
  @@map("users")
}

model AuthSession {
  id                 String    @id @db.VarChar(96)
  userId             String    @db.VarChar(191)
  tokensEncrypted    String    @db.Text
  keycloakSid        String?   @db.VarChar(191)
  keycloakSub        String?   @db.VarChar(191)
  keycloakClientId   String?   @db.VarChar(191)
  refreshVersion     Int       @default(0)
  lastRefreshedAt    DateTime?
  revokedAt          DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([keycloakSid, revokedAt])
  @@index([revokedAt, expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @db.VarChar(191)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(191)
  metadata   Json?
  occurredAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model OutboxEvent {
  id            String       @id @default(cuid()) @db.VarChar(191)
  topic         String       @db.VarChar(150)
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(191)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@map("outbox_events")
}
