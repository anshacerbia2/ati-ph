generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ArtifactType {
  RAW_IMPORT
  IMPORT_REPORT
  OUTPUT_XLSX
  EMAIL_PREVIEW
  ERROR_REPORT
  PROVIDER_EVENT
}

enum ImportBatchStatus {
  UPLOADED
  VERIFYING
  VALIDATED
  INVALID
  FAILED
}

enum ImportRowStatus {
  VALID
  INVALID
  EXCLUDED
}

enum ValidationSeverity {
  ERROR
  WARNING
  INFO
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                   String                  @id @default(uuid()) @db.Uuid
  externalSubject      String                  @unique @db.VarChar(191)
  email                String                  @unique @db.VarChar(320)
  displayName          String?                 @db.VarChar(255)
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  sessions             AuthSession[]
  auditEvents          AuditEvent[]
  artifacts            FileArtifact[]          @relation("ArtifactCreator")
  imports              ImportBatch[]           @relation("ImportUploader")
  editedRows           ImportRow[]             @relation("ImportRowEditor")
  acknowledgedIssues   ImportValidationIssue[] @relation("IssueAcknowledger")
  roleAssignments      UserRoleAssignment[]
  requestedApprovals   ApprovalRequest[]       @relation("ApprovalRequester")
  decidedApprovals     ApprovalRequest[]       @relation("ApprovalDecider")
  publishedOccurrences HolidayOccurrence[]     @relation("OccurrencePublisher")

  @@index([isActive])
  @@map("users")
}

model FileArtifact {
  id              String       @id @default(uuid()) @db.Uuid
  artifactType    ArtifactType
  fileName        String       @db.VarChar(255)
  mimeType        String       @db.VarChar(150)
  sizeBytes       BigInt
  sha256          String       @db.Char(64)
  storageProvider String       @db.VarChar(40)
  storageKey      String       @unique @db.VarChar(1000)
  retentionClass  String       @db.VarChar(50)
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now())
  createdBy       User?        @relation("ArtifactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  importBatch     ImportBatch?

  @@index([sha256])
  @@index([artifactType, createdAt])
  @@map("file_artifacts")
}

model ImportBatch {
  id                    String                  @id @default(uuid()) @db.Uuid
  batchNumber           String                  @unique @db.VarChar(50)
  sourceName            String                  @db.VarChar(200)
  schemaName            String                  @db.VarChar(100)
  schemaVersion         String                  @db.VarChar(30)
  rawArtifactId         String                  @unique @db.Uuid
  fileSha256            String                  @db.Char(64)
  columnMapping         Json
  status                ImportBatchStatus       @default(UPLOADED)
  totalRows             Int                     @default(0)
  validRows             Int                     @default(0)
  invalidRows           Int                     @default(0)
  warningCount          Int                     @default(0)
  uploadedById          String                  @db.Uuid
  uploadedAt            DateTime                @default(now())
  submittedAt           DateTime?
  publishedAt           DateTime?
  failureReason         String?                 @db.Text
  clientPreviewSha256   String?                 @db.Char(64)
  businessContentSha256 String?                 @db.Char(64)
  verificationStartedAt DateTime?
  verifiedAt            DateTime?
  rawArtifact           FileArtifact            @relation(fields: [rawArtifactId], references: [id], onDelete: Restrict)
  uploadedBy            User                    @relation("ImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  rows                  ImportRow[]
  issues                ImportValidationIssue[]
  publishedOccurrences  HolidayOccurrence[]     @relation("PublishedBatchOccurrences")

  @@index([fileSha256])
  @@index([businessContentSha256])
  @@index([status, uploadedAt])
  @@index([status, verificationStartedAt])
  @@map("import_batches")
}

model ImportRow {
  id                  String                  @id @default(uuid()) @db.Uuid
  importBatchId       String                  @db.Uuid
  sourceSheet         String                  @db.VarChar(150)
  sourceRowNumber     Int
  revisionId          String                  @db.Uuid
  rawData             Json
  normalizedData      Json
  status              ImportRowStatus
  warningAcknowledged Boolean                 @default(false)
  excludedReason      String?                 @db.Text
  editedById          String?                 @db.Uuid
  editedAt            DateTime?
  createdAt           DateTime                @default(now())
  importBatch         ImportBatch             @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  editedBy            User?                   @relation("ImportRowEditor", fields: [editedById], references: [id], onDelete: SetNull)
  issues              ImportValidationIssue[]
  publishedOccurrence HolidayOccurrence?      @relation("SourceImportRowOccurrence")

  @@unique([importBatchId, sourceSheet, sourceRowNumber])
  @@index([importBatchId, status])
  @@index([revisionId])
  @@map("import_rows")
}

model ImportValidationIssue {
  id               String             @id @default(uuid()) @db.Uuid
  importBatchId    String             @db.Uuid
  importRowId      String?            @db.Uuid
  severity         ValidationSeverity
  errorCode        String             @db.VarChar(80)
  fieldName        String?            @db.VarChar(100)
  rejectedValue    String?            @db.Text
  message          String             @db.Text
  acknowledgedById String?            @db.Uuid
  acknowledgedAt   DateTime?
  createdAt        DateTime           @default(now())
  importBatch      ImportBatch        @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importRow        ImportRow?         @relation(fields: [importRowId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?              @relation("IssueAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([importBatchId, severity])
  @@index([importRowId])
  @@map("import_validation_issues")
}

model HolidayDefinition {
  id             String              @id @default(uuid()) @db.Uuid
  canonicalName  String              @db.VarChar(200)
  normalizedName String              @unique @db.VarChar(200)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  occurrences    HolidayOccurrence[]

  @@map("holiday_definitions")
}

model HolidayOccurrence {
  id                      String                    @id @default(uuid()) @db.Uuid
  holidayDefinitionId     String                    @db.Uuid
  sourceImportRowId       String                    @unique @db.Uuid
  sourceImportBatchId     String                    @db.Uuid
  startDate               DateTime                  @db.Date
  endDate                 DateTime                  @db.Date
  calendarYear            Int
  publishedById           String                    @db.Uuid
  publishedAt             DateTime                  @default(now())
  supersedesOccurrenceId  String?                   @unique @db.Uuid
  supersededAt            DateTime?
  notificationCommittedAt DateTime?
  definition              HolidayDefinition         @relation(fields: [holidayDefinitionId], references: [id], onDelete: Restrict)
  sourceImportRow         ImportRow                 @relation("SourceImportRowOccurrence", fields: [sourceImportRowId], references: [id], onDelete: Restrict)
  sourceImportBatch       ImportBatch               @relation("PublishedBatchOccurrences", fields: [sourceImportBatchId], references: [id], onDelete: Restrict)
  publishedBy             User                      @relation("OccurrencePublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  supersedesOccurrence    HolidayOccurrence?        @relation("HolidayOccurrenceRevision", fields: [supersedesOccurrenceId], references: [id], onDelete: Restrict)
  supersededBy            HolidayOccurrence?        @relation("HolidayOccurrenceRevision")
  regions                 HolidayOccurrenceRegion[]
  dates                   HolidayOccurrenceDate[]

  @@index([sourceImportBatchId, publishedAt])
  @@index([calendarYear, startDate])
  @@index([supersededAt, startDate])
  @@index([notificationCommittedAt])
  @@map("holiday_occurrences")
}

model HolidayOccurrenceRegion {
  holidayOccurrenceId String            @db.Uuid
  calendarRegionId    String            @db.Uuid
  occurrence          HolidayOccurrence @relation(fields: [holidayOccurrenceId], references: [id], onDelete: Cascade)
  calendarRegion      CalendarRegion    @relation(fields: [calendarRegionId], references: [id], onDelete: Restrict)

  @@id([holidayOccurrenceId, calendarRegionId])
  @@index([calendarRegionId, holidayOccurrenceId])
  @@map("holiday_occurrence_regions")
}

model HolidayOccurrenceDate {
  id                  String            @id @default(uuid()) @db.Uuid
  holidayOccurrenceId String            @db.Uuid
  occurrenceDate      DateTime          @db.Date
  dayOfWeek           String            @db.VarChar(9)
  dayType             String            @db.VarChar(8)
  occurrence          HolidayOccurrence @relation(fields: [holidayOccurrenceId], references: [id], onDelete: Cascade)

  @@unique([holidayOccurrenceId, occurrenceDate])
  @@index([occurrenceDate])
  @@map("holiday_occurrence_dates")
}

model ApprovalRequest {
  id                String         @id @default(uuid()) @db.Uuid
  resourceType      String         @db.VarChar(100)
  resourceId        String         @db.VarChar(191)
  contentHash       String         @db.Char(64)
  status            ApprovalStatus @default(PENDING)
  activeResourceKey String?        @unique @db.VarChar(320)
  requestedById     String         @db.Uuid
  requestedAt       DateTime       @default(now())
  decidedById       String?        @db.Uuid
  decidedAt         DateTime?
  decisionReason    String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  requestedBy       User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy         User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, requestedAt])
  @@index([status, requestedAt])
  @@map("approval_requests")
}

model AuthSession {
  // Intentional exception: this is a 256-bit opaque bearer-session handle,
  // not a domain/entity identifier. Keeping it non-UUID preserves session-token semantics.
  id               String    @id @db.VarChar(96)
  userId           String    @db.Uuid
  tokensEncrypted  String    @db.Text
  keycloakSid      String?   @db.VarChar(191)
  keycloakSub      String?   @db.VarChar(191)
  keycloakClientId String?   @db.VarChar(191)
  refreshVersion   Int       @default(0)
  lastRefreshedAt  DateTime?
  revokedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([keycloakSid, revokedAt])
  @@index([revokedAt, expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(191)
  metadata   Json?
  occurredAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  topic         String       @db.VarChar(150)
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(191)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@map("outbox_events")
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique @db.VarChar(80)
  name        String               @db.VarChar(120)
  description String?              @db.VarChar(500)
  isActive    Boolean              @default(true)
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@index([isActive, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(500)
  isActive    Boolean          @default(true)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  menus       Menu[]

  @@index([isActive, code])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Menu {
  id                   String      @id @default(uuid()) @db.Uuid
  code                 String      @unique @db.VarChar(100)
  label                String      @db.VarChar(160)
  path                 String?     @db.VarChar(255)
  parentId             String?     @db.Uuid
  requiredPermissionId String?     @db.Uuid
  sortOrder            Int         @default(0)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  parent               Menu?       @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             Menu[]      @relation("MenuTree")
  requiredPermission   Permission? @relation(fields: [requiredPermissionId], references: [id], onDelete: Restrict)

  @@index([parentId, sortOrder])
  @@index([requiredPermissionId])
  @@index([isActive, sortOrder])
  @@map("menus")
}

model Client {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(200)
  normalizedName String        @unique @db.VarChar(200)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  serviceTeams   ServiceTeam[]
  contacts       Contact[]

  @@index([isActive, name])
  @@map("clients")
}

model ServiceTeam {
  id             String               @id @default(uuid()) @db.Uuid
  clientId       String               @db.Uuid
  name           String               @db.VarChar(200)
  normalizedName String               @db.VarChar(200)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscriptions  ClientSubscription[]

  @@unique([clientId, normalizedName])
  @@index([clientId, isActive, name])
  @@map("service_teams")
}

model Contact {
  id                   String                  @id @default(uuid()) @db.Uuid
  clientId             String                  @db.Uuid
  displayName          String?                 @db.VarChar(200)
  email                String                  @db.VarChar(320)
  normalizedEmail      String                  @db.VarChar(320)
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recipientAssignments SubscriptionRecipient[]

  @@unique([clientId, normalizedEmail])
  @@index([clientId, isActive])
  @@map("contacts")
}

model ClientSubscription {
  id               String                  @id @default(uuid()) @db.Uuid
  serviceTeamId    String                  @db.Uuid
  calendarRegionId String                  @db.Uuid
  effectiveFrom    DateTime?               @db.Date
  effectiveTo      DateTime?               @db.Date
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  serviceTeam      ServiceTeam             @relation(fields: [serviceTeamId], references: [id], onDelete: Restrict)
  calendarRegion   CalendarRegion          @relation(fields: [calendarRegionId], references: [id], onDelete: Restrict)
  recipients       SubscriptionRecipient[]

  @@index([serviceTeamId, calendarRegionId])
  @@index([calendarRegionId, isActive])
  @@index([serviceTeamId, isActive])
  @@map("client_subscriptions")
}

model SubscriptionRecipient {
  subscriptionId String             @db.Uuid
  contactId      String             @db.Uuid
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([subscriptionId, contactId])
  @@index([contactId, isActive])
  @@map("subscription_recipients")
}

model CalendarRegion {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique @db.VarChar(16)
  displayName         String                    @db.VarChar(120)
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  aliases             CalendarRegionAlias[]
  holidayOccurrences  HolidayOccurrenceRegion[]
  clientSubscriptions ClientSubscription[]

  @@index([isActive, code])
  @@map("calendar_regions")
}

model CalendarRegionAlias {
  id              String         @id @default(uuid()) @db.Uuid
  regionId        String         @db.Uuid
  alias           String         @db.VarChar(120)
  normalizedAlias String         @unique @db.VarChar(120)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  region          CalendarRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@index([regionId, isActive])
  @@map("calendar_region_aliases")
}
