# ATI PH — LOCAL DEVELOPMENT profile
#
# Copy to `.env`. Every variable ATI PH reads is written out below, including the ones
# whose value equals the code default, so this file alone tells you what the process
# will do. Nothing is left to be inferred from `src/config/server-env.ts`.
#
#   what this profile is for   developing on your own machine
#   email delivery             MANUAL CONNECTIVITY TEST ONLY
#   worker                     DISABLED — refuses to start
#   can it email a client      no: no automatic delivery, and the worker is off
#
# The three other profiles are `.env.test.example` and `.env.production.example`.
# `docs/ENVIRONMENT-PROFILES.md` explains what each one is allowed to do and why.

NODE_ENV=development

# ── Where the app is served ───────────────────────────────────────────────────
#
# Empty base path = served at the origin root, which is what a standalone local run
# wants. Set it to `/apps/ph-notification/app` only when running behind ATI One's
# proxy, and change the port below to match — every URL here has to be the address
# the *browser* uses, not the address the process binds.
#
# Inlined at build time. Restart after changing it; a rebuild is not enough on its own.
NEXT_PUBLIC_APP_BASE_PATH=
DEV_APP_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/callback/keycloak
ATI_ONE_RETURN_URL=http://localhost:3000/

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ati_ph_db?schema=public

# ── Identity ──────────────────────────────────────────────────────────────────
#
# The callback URL above must be registered on this client character for character,
# or Keycloak answers `Invalid parameter: redirect_uri` and names nothing else.
#
# `ph-notif` is this app's own client, in every environment. It said `ati-one-portal`
# here, which is the portal's client — borrowing it would have signed people in against
# a client whose redirect URIs and scopes belong to a different application, and the
# realm cannot tell the two apart afterwards.
#
# The secret differs per realm and is never committed. Keycloak → Clients → ph-notif →
# Credentials.
KEYCLOAK_ISSUER=https://one.atibusinessgroup.com/auth/realms/ati-one
KEYCLOAK_CLIENT_ID=ph-notif
KEYCLOAK_CLIENT_SECRET=replace-with-client-secret

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30

# ── ATI One proxy ─────────────────────────────────────────────────────────────
#
# True here too, and this said `false` until the topology was settled.
#
# The old comment read "false locally because you reach the app directly", which
# described an arrangement that no longer exists: ATI PH is reachable only through
# ATI One, and a local profile that quietly allowed the direct route would be a
# developer testing a different application from the one that ships.
#
# **Both sides or neither.** This value must equal
# `ATI_ONE_PH_NOTIFICATION_PROXY_SECRET` in the portal's `backend/.env`, which is what
# the seed writes onto the catalogue row. Set here and unset there means this app
# refuses every request the portal forwards and goes completely dark; unset here and
# set there is merely pointless. The schema refuses `true` with no secret at all.
TRUST_ATI_ONE_PROXY=true
ATI_ONE_PROXY_SECRET=replace-with-at-least-32-random-characters

# ── Storage and import limits ─────────────────────────────────────────────────
ARTIFACT_STORAGE_DIR=./storage/artifacts
IMPORT_MAX_FILE_SIZE_BYTES=10485760

# ── Worker ────────────────────────────────────────────────────────────────────
#
# DISABLED, and that is the point of this profile. `npm run worker` prints why and
# exits zero rather than starting. A local worker against a local database claims
# jobs, promotes schedules and mutates delivery state — work nobody asked for, on
# data you are probably in the middle of editing.
#
# Turn it on deliberately, for a specific test, and turn it off again.
NOTIFICATION_WORKER_ENABLED=false

WORKER_POLL_INTERVAL_MS=60000
NOTIFICATION_SCHEDULER_BATCH_SIZE=100
NOTIFICATION_DELIVERY_BATCH_SIZE=25
NOTIFICATION_DELIVERY_LEASE_SECONDS=120

# Shadow-only: plans are scanned and alerts recorded, nothing is auto-committed.
NOTIFICATION_TRUSTED_AUTOMATION_ENABLED=false
NOTIFICATION_AUTOMATION_BATCH_SIZE=50
NOTIFICATION_AUTOMATION_HORIZON_DAYS=400
NOTIFICATION_SCHEDULER_LAG_THRESHOLD_SECONDS=300

NOTIFICATION_RETENTION_ENABLED=false
NOTIFICATION_OPERATIONAL_ALERT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_BATCH_SIZE=100

# ── Email ─────────────────────────────────────────────────────────────────────
#
# SMTP is the *transport*, not permission to send. What this profile permits is one
# command — `npm run email:smtp:test -- --send` — which proves credentials, TLS, host
# and sender identity against one same-domain internal mailbox. It touches no
# NotificationJob and needs no worker.
EMAIL_DELIVERY_MODE=SMTP

EMAIL_SENDER_IDENTITY_CODE=PH_NOTIFICATION
EMAIL_FROM_ADDRESS=apps@atibusinessgroup.com
EMAIL_FROM_NAME=ATI Business Group
# EMAIL_REPLY_TO=
EMAIL_TRANSPORT_CODE=ATI_GOOGLE_DIRECT

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true
EMAIL_SMTP_USER=apps@atibusinessgroup.com
EMAIL_SMTP_PASSWORD=replace-with-approved-application-credential
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000

# The connectivity test: this profile's one delivery path.
# Recipient domain must equal the sender domain.
EMAIL_SMTP_TEST_ENABLED=true
EMAIL_SMTP_TEST_RECIPIENT=your.name@atibusinessgroup.com

# The pilot belongs to `.env.test.example`. The schema refuses both at once — they are
# two validations with two recipients, and a profile has to say which one it is.
EMAIL_SMTP_PILOT_ENABLED=false
EMAIL_SMTP_PILOT_RECIPIENT=your.name@atibusinessgroup.com

# Automatic worker delivery: closed, and closed twice.
#
# The schema also refuses `EMAIL_SMTP_AUTOMATIC_DELIVERY_ENABLED=true` here, because
# it requires the worker — which this profile disables. Arming one without the other
# describes an intent the deployment cannot carry out.
EMAIL_SMTP_AUTOMATIC_DELIVERY_ENABLED=false
EMAIL_DELIVERY_KILL_SWITCH=true
# EMAIL_DELIVERY_KILL_SWITCH_PATH=
EMAIL_SMTP_PRODUCTION_RELEASE_APPROVED=false

# ── Seeded delivery-test routing ──────────────────────────────────────────────
#
# Creates one client `Test` in region SG whose only recipient is this address, and the
# one policy permitted to auto-send. Unset it and nothing is seeded. Region SG is
# chosen because `Client_Master` puts no subscription there, so a Singapore holiday
# reaches that row and nothing else. See docs/LOCAL-EMAIL-TESTING.md §7.2.
DELIVERY_TEST_RECIPIENT=your.name@atibusinessgroup.com

# ── Bootstrap administrator ───────────────────────────────────────────────────
#
# One address that becomes ADMINISTRATOR by signing in, and only while it holds no role
# at all. A fresh database has roles and permissions but nobody holding them, so the
# first person to arrive is refused every screen — including the screen that grants
# roles. This is the way in.
#
# Unset means nobody, which is the safe default: a missing value fails as "no one can
# get in", which is loud and recoverable.
#
# ⚠ CLEAR THIS once a human administrator exists. While it is set, that account cannot
#   be demoted: strip its last role and the next sign-in grants ADMINISTRATOR again,
#   because from the application's side that is indistinguishable from a first sign-in.
#   Every grant is written to the audit trail with the reason.
#
# Declared as an email in the schema, so a value that could never match anybody is
# refused at boot rather than silently granting nothing. That is what the profile
# contract test caught when this line first said `replace-with-your-ati-address`.
BOOTSTRAP_ADMINISTRATOR_EMAIL=your.name@atibusinessgroup.com
