# Runtime mode used by production readiness and SMTP production release controls.
NODE_ENV=production

# This value is inlined at build time. Rebuild when it changes.
NEXT_PUBLIC_APP_BASE_PATH=/apps/ph-notification/app

PUBLIC_APP_URL=https://one.atibusinessgroup.com/apps/ph-notification/app
OIDC_CALLBACK_URL=https://one.atibusinessgroup.com/apps/ph-notification/app/api/auth/callback/keycloak

DATABASE_URL=postgresql://ati_ph_user:replace-with-db-password@postgres:5432/ati_ph_db?schema=public

# Temporary shared ATI One Keycloak client.
KEYCLOAK_ISSUER=https://one.atibusinessgroup.com/auth/realms/ati-one
KEYCLOAK_CLIENT_ID=ati-one-portal
KEYCLOAK_CLIENT_SECRET=replace-with-ati-one-client-secret

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30

TRUST_ATI_ONE_PROXY=true
ATI_ONE_PROXY_SECRET=replace-with-at-least-32-random-characters
ATI_ONE_RETURN_URL=https://one.atibusinessgroup.com/

ARTIFACT_STORAGE_DIR=/var/lib/ati-ph/artifacts
IMPORT_MAX_FILE_SIZE_BYTES=10485760

WORKER_POLL_INTERVAL_MS=60000
NOTIFICATION_SCHEDULER_BATCH_SIZE=100
NOTIFICATION_DELIVERY_BATCH_SIZE=25
NOTIFICATION_DELIVERY_LEASE_SECONDS=120

# -------------------------------------------------------------------
# Email Delivery Engine
# -------------------------------------------------------------------
# Production remains fail-closed until automatic SMTP NotificationJob
# execution receives a separate release approval.
EMAIL_DELIVERY_MODE=DISABLED

EMAIL_SENDER_IDENTITY_CODE=PH_NOTIFICATION
EMAIL_FROM_ADDRESS=apps@atibusinessgroup.com
EMAIL_FROM_NAME=ATI Business Group
# EMAIL_REPLY_TO=
EMAIL_TRANSPORT_CODE=ATI_GOOGLE_RELAY

# Google Workspace relay is the current production candidate only.
# ATI IT must configure/approve relay authorization before enablement.
# EMAIL_SMTP_HOST=smtp-relay.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true

# Relay authentication depends on ATI Google Workspace policy.
# Do not commit credentials.
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000

# Manual SMTP test stays disabled in production by default.
EMAIL_SMTP_TEST_ENABLED=false
# EMAIL_SMTP_TEST_RECIPIENT=

# Controlled NotificationJob SMTP pilot remains disabled in production.
EMAIL_SMTP_PILOT_ENABLED=false
# EMAIL_SMTP_PILOT_RECIPIENT=

# IMPORTANT:
# SMTP worker execution is implemented but remains fail-closed behind explicit
# automatic enablement, kill-switch, and production-release approval controls.

# Trusted automation remains shadow-only until operational release.
NOTIFICATION_TRUSTED_AUTOMATION_ENABLED=false
NOTIFICATION_AUTOMATION_BATCH_SIZE=50
NOTIFICATION_AUTOMATION_HORIZON_DAYS=400
NOTIFICATION_SCHEDULER_LAG_THRESHOLD_SECONDS=300

# Retention remains disabled until retention ownership is approved.
NOTIFICATION_RETENTION_ENABLED=false
NOTIFICATION_OPERATIONAL_ALERT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_BATCH_SIZE=100

# Automatic SMTP stays closed by default even when SMTP transport is configured.
EMAIL_SMTP_AUTOMATIC_DELIVERY_ENABLED=false
EMAIL_DELIVERY_KILL_SWITCH=true
# EMAIL_DELIVERY_KILL_SWITCH_PATH=/var/run/ati-ph/email-delivery.kill

# Final production external-delivery approval gate.
# Set true only after ATI IT route approval, secret-management approval,
# recipient-scope authorization, runbook ownership, and business acceptance.
EMAIL_SMTP_PRODUCTION_RELEASE_APPROVED=false
