# ATI PH — PRODUCTION profile
#
# Copy to `.env` on the production deployment. Every variable ATI PH reads is written
# out below, including the ones whose value equals the code default, so this file alone
# tells you what the process will do.
#
#   what this profile is for   production
#   email delivery             AUTOMATIC — the worker sends to real client recipients
#   worker                     ENABLED
#   can it email a client      YES. That is what this profile is.
#
# ⚠ The delivery gates below are written in the OPEN position, because that is what
#   production means. They are not a default to inherit — `EMAIL_SMTP_PRODUCTION_RELEASE_APPROVED`
#   is the line that records a human decision, and the release evidence it stands for is
#   listed in `docs/LOCAL-EMAIL-TESTING.md` §9 and `docs/SMTP-AUTOMATIC-DELIVERY-RUNBOOK.md`.
#
#   Until that evidence exists — ATI IT-approved sender route, approved secret path,
#   authorised client-recipient scope, monitoring ownership, business acceptance — set
#   the four delivery lines to the closed position shown in `.env.test.example` and
#   deploy the rest of this file as it is. The application runs fully; it just does not
#   send. That is a deliberate, reversible operating state, not a broken deployment.

NODE_ENV=production

# ── Where the app is served ───────────────────────────────────────────────────
#
# HTTPS is checked, not assumed: `evaluateProductionReadiness` fails the deployment if
# `PUBLIC_APP_URL` or `OIDC_CALLBACK_URL` is not https under NODE_ENV=production.
# Inlined at build time — rebuild the image when the mount path changes.
NEXT_PUBLIC_APP_BASE_PATH=/apps/ph-notification/app
DEV_APP_ORIGIN=https://one.atibusinessgroup.com
PUBLIC_APP_URL=https://one.atibusinessgroup.com/apps/ph-notification/app
OIDC_CALLBACK_URL=https://one.atibusinessgroup.com/apps/ph-notification/app/api/auth/callback/keycloak
ATI_ONE_RETURN_URL=https://one.atibusinessgroup.com/

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ati_ph_user:replace-with-db-password@postgres:5432/ati_ph_db?schema=public

# ── Identity ──────────────────────────────────────────────────────────────────
#
# The client ID is `ph-notif` in every environment; the secret is per realm and is never
# committed — this file is tracked. Keycloak → Clients → ph-notif → Credentials.
KEYCLOAK_ISSUER=https://one.atibusinessgroup.com/auth/realms/ati-one
KEYCLOAK_CLIENT_ID=ph-notif
KEYCLOAK_CLIENT_SECRET=replace-with-client-secret

# Readiness refuses a secret shorter than 32 characters or containing `replace-with`,
# `changeme`, `example` or `placeholder`. A forgotten value fails the deployment
# instead of running with a guessable one.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30

# ── ATI One proxy ─────────────────────────────────────────────────────────────
#
# Both required in production, and readiness enforces it. This deployment publishes a
# port; the header is what makes reaching that port insufficient.
TRUST_ATI_ONE_PROXY=true
ATI_ONE_PROXY_SECRET=replace-with-at-least-32-random-characters

# ── Storage and import limits ─────────────────────────────────────────────────
ARTIFACT_STORAGE_DIR=/var/lib/ati-ph/artifacts
IMPORT_MAX_FILE_SIZE_BYTES=10485760

# ── Worker ────────────────────────────────────────────────────────────────────
NOTIFICATION_WORKER_ENABLED=true

WORKER_POLL_INTERVAL_MS=60000
NOTIFICATION_SCHEDULER_BATCH_SIZE=100
NOTIFICATION_DELIVERY_BATCH_SIZE=25

# Under NODE_ENV=production an SMTP claim is not retry-safe after lease expiry: the
# send may have happened. Keep this comfortably longer than a slow SMTP handshake, so
# recovery reconciles rarely.
NOTIFICATION_DELIVERY_LEASE_SECONDS=120

NOTIFICATION_TRUSTED_AUTOMATION_ENABLED=true
NOTIFICATION_AUTOMATION_BATCH_SIZE=50
NOTIFICATION_AUTOMATION_HORIZON_DAYS=400
NOTIFICATION_SCHEDULER_LAG_THRESHOLD_SECONDS=300

NOTIFICATION_RETENTION_ENABLED=true
NOTIFICATION_OPERATIONAL_ALERT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_BATCH_SIZE=100

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_DELIVERY_MODE=SMTP

EMAIL_SENDER_IDENTITY_CODE=PH_NOTIFICATION
EMAIL_FROM_ADDRESS=apps@atibusinessgroup.com
EMAIL_FROM_NAME=ATI Business Group
# EMAIL_REPLY_TO=

# The relay is the production candidate and ATI IT owns its authorisation, sender
# restrictions, IP allowlisting and credential policy. Direct SMTP is the
# development/pilot route and is not a production decision this repository may make.
EMAIL_TRANSPORT_CODE=ATI_GOOGLE_RELAY
EMAIL_SMTP_HOST=smtp-relay.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true
EMAIL_SMTP_USER=apps@atibusinessgroup.com
EMAIL_SMTP_PASSWORD=replace-with-approved-application-credential
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000

# Both manual commands off, and readiness fails the deployment if either is on. They
# exist to validate a route by hand; in production the worker owns delivery, and having
# both would make it impossible to say which path sent a given message.
EMAIL_SMTP_TEST_ENABLED=false
# EMAIL_SMTP_TEST_RECIPIENT=
EMAIL_SMTP_PILOT_ENABLED=false
# EMAIL_SMTP_PILOT_RECIPIENT=

# The three lines that let production send.
#
# All three are required together: automatic delivery on, kill switch off, and — only
# under NODE_ENV=production — an explicit release approval. Any one of them in the
# other position stops delivery, and the worker logs which.
#
# `EMAIL_DELIVERY_KILL_SWITCH_PATH` is the operational stop. Set it to a path on a
# writable volume, and `touch` that file to halt delivery on the next cycle without a
# deploy, a restart, or an edit to this file. Leave it configured and absent.
EMAIL_SMTP_AUTOMATIC_DELIVERY_ENABLED=true
EMAIL_DELIVERY_KILL_SWITCH=false
EMAIL_DELIVERY_KILL_SWITCH_PATH=/var/lib/ati-ph/STOP-EMAIL-DELIVERY
EMAIL_SMTP_PRODUCTION_RELEASE_APPROVED=true

# ── Seeded delivery-test routing ──────────────────────────────────────────────
#
# Unset in production, deliberately. It seeds a client whose policy is the only one
# permitted to auto-send, which is a development affordance and has no place in a
# database serving real clients.
# DELIVERY_TEST_RECIPIENT=

# ── Bootstrap administrator ───────────────────────────────────────────────────
#
# One address that becomes ADMINISTRATOR by signing in, and only while it holds no role
# at all. A fresh database has roles and permissions but nobody holding them, so the
# first person to arrive is refused every screen — including the screen that grants
# roles. This is the way in.
#
# Unset means nobody, which is the safe default: a missing value fails as "no one can
# get in", which is loud and recoverable.
#
# ⚠ CLEAR THIS once a human administrator exists. While it is set, that account cannot
#   be demoted: strip its last role and the next sign-in grants ADMINISTRATOR again,
#   because from the application's side that is indistinguishable from a first sign-in.
#   Every grant is written to the audit trail with the reason.
#
# Production: set it for the first deploy, sign in once, then remove it and restart.
# BOOTSTRAP_ADMINISTRATOR_EMAIL=
