# This value is inlined at build time. Rebuild when it changes.
NEXT_PUBLIC_APP_BASE_PATH=/apps/ph-notification/app
DEV_APP_ORIGIN=http://localhost:3005

# Public URL including the base path above.
PUBLIC_APP_URL=http://localhost:3005/apps/ph-notification/app

# Local callback already registered on the shared ATI One Keycloak client.
OIDC_CALLBACK_URL=http://localhost:3005/api/auth/callback/keycloak

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ati_ph_db?schema=public

# Temporary decision: reuse ATI One's Keycloak client ID/credential.
KEYCLOAK_ISSUER=https://one.atibusinessgroup.com/auth/realms/ati-one
KEYCLOAK_CLIENT_ID=ati-one-portal
KEYCLOAK_CLIENT_SECRET=replace-with-ati-one-client-secret

# Generate independently for ati-ph.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30

# Keycloak owns authentication/identity only.
# ATI PH roles and permissions are PostgreSQL-owned.

TRUST_ATI_ONE_PROXY=false
ATI_ONE_PROXY_SECRET=replace-with-at-least-32-random-characters
ATI_ONE_RETURN_URL=http://localhost:3005/

ARTIFACT_STORAGE_DIR=./storage/artifacts
IMPORT_MAX_FILE_SIZE_BYTES=10485760

# Worker
WORKER_POLL_INTERVAL_MS=60000
NOTIFICATION_SCHEDULER_BATCH_SIZE=100
NOTIFICATION_DELIVERY_BATCH_SIZE=25
NOTIFICATION_DELIVERY_LEASE_SECONDS=120

# -------------------------------------------------------------------
# Email Delivery Engine
# -------------------------------------------------------------------
# Fail-closed default. Change deliberately for local testing.
EMAIL_DELIVERY_MODE=DISABLED

EMAIL_SENDER_IDENTITY_CODE=PH_NOTIFICATION
EMAIL_FROM_ADDRESS=apps@atibusinessgroup.com
EMAIL_FROM_NAME=ATI Business Group
# EMAIL_REPLY_TO=
EMAIL_TRANSPORT_CODE=ATI_PRIMARY

# Generic SMTP configuration
# Google Workspace direct SMTP local-test example:
# EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true
# EMAIL_SMTP_USER=apps@atibusinessgroup.com
# EMAIL_SMTP_PASSWORD=replace-with-IT-approved-application-credential
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000

# Manual SMTP connectivity test
# This alone does not send. Command also requires: npm run email:smtp:test -- --send
EMAIL_SMTP_TEST_ENABLED=false
# EMAIL_SMTP_TEST_RECIPIENT=your.name@atibusinessgroup.com

# Controlled business-content SMTP pilot
# Uses exact frozen NotificationJob content but overrides delivery to one
# same-domain internal recipient and never mutates NotificationJob state.
EMAIL_SMTP_PILOT_ENABLED=false
# EMAIL_SMTP_PILOT_RECIPIENT=your.name@atibusinessgroup.com

# Safe in-memory transport example:
# EMAIL_DELIVERY_MODE=STREAM
# EMAIL_TRANSPORT_CODE=SAFE_STREAM
#
# WARNING:
# Running the worker in STREAM mode can mutate durable NotificationJob state
# in the configured database even though no external email is sent.

# Trusted automation
# Default is shadow-only: scans and alerts without auto-commit.
NOTIFICATION_TRUSTED_AUTOMATION_ENABLED=false
NOTIFICATION_AUTOMATION_BATCH_SIZE=50
NOTIFICATION_AUTOMATION_HORIZON_DAYS=400
NOTIFICATION_SCHEDULER_LAG_THRESHOLD_SECONDS=300

# Operational retention
NOTIFICATION_RETENTION_ENABLED=false
NOTIFICATION_OPERATIONAL_ALERT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_BATCH_SIZE=100

# Automatic SMTP release controls
# All remain fail-closed unless deliberately changed.
EMAIL_SMTP_AUTOMATIC_DELIVERY_ENABLED=false
EMAIL_DELIVERY_KILL_SWITCH=true
# EMAIL_DELIVERY_KILL_SWITCH_PATH=.runtime/email-delivery.kill

# Required only for automatic SMTP execution when NODE_ENV=production.
EMAIL_SMTP_PRODUCTION_RELEASE_APPROVED=false
