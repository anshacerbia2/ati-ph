# This value is inlined at build time. Rebuild when it changes.
NEXT_PUBLIC_APP_BASE_PATH=/apps/ph-notification/app
DEV_APP_ORIGIN=http://localhost:3000

# Public URL including the base path above.
PUBLIC_APP_URL=http://localhost:3000/apps/ph-notification/app
# Local callback already registered on the shared ATI One Keycloak client.
# The dev server redirects it to ATI PH's mounted callback handler.
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/callback/keycloak
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ati_ph?schema=public

# Temporary decision: reuse ATI One's Keycloak client ID/credential.
KEYCLOAK_ISSUER=https://one.atibusinessgroup.com/auth/realms/ati-one
KEYCLOAK_CLIENT_ID=ati-one-portal
KEYCLOAK_CLIENT_SECRET=replace-with-ati-one-client-secret

# Generate independently for ati-ph. Do not copy ATI One's session secret.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30

# Comma-separated Keycloak roles, checked from realm_access.roles.
KEYCLOAK_ADMIN_ROLES=ati-ph-administrator
KEYCLOAK_OPERATOR_ROLES=ati-ph-operator
KEYCLOAK_APPROVER_ROLES=ati-ph-approver

# Enable in environments where only ATI One may proxy/embed the app.
TRUST_ATI_ONE_PROXY=false
ATI_ONE_PROXY_SECRET=replace-with-at-least-32-random-characters
ATI_ONE_RETURN_URL=http://localhost:3000/

WORKER_POLL_INTERVAL_MS=60000
